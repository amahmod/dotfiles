# ==============================================================================
# Zathura PDF Viewer Configuration
# Theme: Catppuccin Macchiato
# ==============================================================================

# Clipboard
set selection-clipboard clipboard

# Interface & Layout
set statusbar-h-padding 10
set statusbar-v-padding 10
set page-padding 8
set adjust-open "width"
set render-loading true
set scroll-step 50
set window-title-home-tild true

# Colors (Catppuccin Macchiato)
set default-bg "#24273a"
set default-fg "#cad3f5"

set statusbar-bg "#1e2030"
set statusbar-fg "#cad3f5"

set inputbar-bg "#1e2030"
set inputbar-fg "#cad3f5"

set notification-bg "#1e2030"
set notification-fg "#cad3f5"

set notification-error-bg "#ed8796"
set notification-error-fg "#1e2030"

set notification-warning-bg "#eed49f"
set notification-warning-fg "#1e2030"

set highlight-color "rgba(198, 160, 246, 0.5)"
set highlight-active-color "rgba(166, 227, 161, 0.5)"

set completion-bg "#1e2030"
set completion-fg "#cad3f5"
set completion-highlight-bg "#363a4f"
set completion-highlight-fg "#c6a0f6"

set index-bg "#1e2030"
set index-fg "#cad3f5"
set index-active-bg "#363a4f"
set index-active-fg "#c6a0f6"

# Recolor mode (Dark mode for PDFs)
set recolor true
set recolor-lightcolor "#24273a"
set recolor-darkcolor "#cad3f5"
set recolor-reverse-video "true"
set recolor-keephues "true"

# Keybindings (Vim-style shortcuts)
map i recolor
map r reload
map R rotate
map [fullscreen] a adjust_window best-fit
map [fullscreen] s adjust_window width
