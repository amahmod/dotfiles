{
    "$schema": "https://biomejs.dev",
    "formatter": {
        "enabled": true,
        "lineWidth": 80,
        "indentStyle": "space",
        "indentWidth": 4,
        "bracketSpacing": true
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single",
            "trailingCommas": "none",
            "bracketSameLine": true,
            "arrowParentheses": "asNeeded"
        }
    }
}
