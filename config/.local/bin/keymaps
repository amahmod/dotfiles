#!/usr/bin/env python3
"""
keymaps: Multi-Application Keybinding Helper & Cheatsheet Generator
Supports Hyprland, WezTerm, Neovim, Yazi, Thunar, IMV, Zathura, and Kitty.

Commands:
  keymaps [--menu]       Launch interactive GUI fuzzy finder (Wofi)
  keymaps --fzf          Launch interactive terminal fuzzy finder (Fzf)
  keymaps --app <name>   Filter by specific application
  keymaps sync           Extract keymaps & comments from configs into ~/.config/keymaps/
  keymaps report [-o F]  Generate a comprehensive Markdown cheatsheet report
  keymaps list [--json]  Print all keymaps as plain text or JSON
"""

import os
import sys
import re
import json
import shutil
import argparse
import subprocess
import xml.etree.ElementTree as ET
from pathlib import Path
from typing import List, Dict, Any, Optional

HOME = Path.home()


def find_repo_root() -> Path:
    p = Path(__file__).resolve()
    for parent in p.parents:
        if (parent / ".git").exists() or (parent / "install.sh").exists():
            return parent
    return HOME / ".arch_setup"


REPO_ROOT = find_repo_root()
DOTFILES_CONFIG = REPO_ROOT / "config" / ".config"
USER_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))

SUPPORTED_APPS = [
    "hypr",
    "wezterm",
    "nvim",
    "yazi",
    "thunar",
    "imv",
    "zathura",
    "kitty",
]

APP_DISPLAY_NAMES = {
    "hypr": "Hyprland",
    "wezterm": "WezTerm",
    "nvim": "Neovim",
    "yazi": "Yazi",
    "thunar": "Thunar",
    "imv": "IMV",
    "zathura": "Zathura",
    "kitty": "Kitty",
}

APP_ICONS = {
    "hypr": "",
    "wezterm": "",
    "nvim": "",
    "yazi": "󰇥",
    "thunar": "󰉋",
    "imv": "",
    "zathura": "",
    "kitty": "󰄛",
}


def get_config_file(rel_path: str) -> Optional[Path]:
    """Finds a config file either in ~/.config or within the dotfiles repository."""
    p_user = USER_CONFIG / rel_path
    if p_user.exists():
        return p_user
    p_repo = DOTFILES_CONFIG / rel_path
    if p_repo.exists():
        return p_repo
    return None


def get_keymaps_dir() -> Path:
    """Returns the directory where app JSON files are stored."""
    repo_km = DOTFILES_CONFIG / "keymaps"
    if DOTFILES_CONFIG.exists():
        repo_km.mkdir(parents=True, exist_ok=True)
        return repo_km
    user_km = USER_CONFIG / "keymaps"
    user_km.mkdir(parents=True, exist_ok=True)
    return user_km


