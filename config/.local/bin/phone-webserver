    <div class="card">
      <h2>
        📥 Download from PC
        <button class="refresh-btn" onclick="fetchFiles()">↻ Refresh</button>
      </h2>
      <div class="file-list" id="fileList">
        <p class="empty-msg">Loading files...</p>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('fileInput');
    const dropZone = document.getElementById('dropZone');
    const progressList = document.getElementById('progressList');
    const fileList = document.getElementById('fileList');

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        uploadFiles(Array.from(fileInput.files));
        fileInput.value = '';
      }
    });

    function uploadFiles(files) {
      files.forEach(file => {
        const item = document.createElement('div');
        item.className = 'progress-item';
        item.innerHTML = `
          <div class="progress-header">
            <span style="font-weight: 500;">${file.name}</span>
            <span class="pct">0%</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill"></div>
          </div>
        `;
        progressList.prepend(item);

        const pctElem = item.querySelector('.pct');
        const fillElem = item.querySelector('.progress-bar-fill');

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/upload?filename=' + encodeURIComponent(file.name));

        xhr.upload.onprogress = (e) => {
          if (e.lengthComputable) {
            const pct = Math.round((e.loaded / e.total) * 100);
            pctElem.textContent = pct + '%';
            fillElem.style.width = pct + '%';
          }
        };

        xhr.onload = () => {
          if (xhr.status === 200) {
            pctElem.textContent = '✔ Done';
            pctElem.style.color = 'var(--success)';
            fillElem.classList.add('done');
            setTimeout(fetchFiles, 800);
          } else {
            pctElem.textContent = '✖ Error';
            pctElem.style.color = '#ed8796';
          }
        };

        xhr.onerror = () => {
          pctElem.textContent = '✖ Failed';
          pctElem.style.color = '#ed8796';
        };

        xhr.send(file);
      });
    }

    function fetchFiles() {
      fetch('/api/files')
        .then(res => res.json())
        .then(files => {
          if (!files || files.length === 0) {
            fileList.innerHTML = '<p class="empty-msg">No files currently in shared folder on PC.</p>';
            return;
          }
          fileList.innerHTML = '';
          files.forEach(f => {
            const el = document.createElement('div');
            el.className = 'file-item';
            el.innerHTML = `
              <div>
                <div class="file-name">${f.name}</div>
                <div class="file-meta">${f.size_formatted}</div>
              </div>
              <a class="btn-download" href="/download/${encodeURIComponent(f.name)}" download>Download</a>
            `;
            fileList.appendChild(el);
          });
        })
        .catch(() => {
          fileList.innerHTML = '<p class="empty-msg">Failed to load files from PC.</p>';
        });
    }

    fetchFiles();
  </script>
</body>
</html>
"""


class FastTransferHandler(http.server.BaseHTTPRequestHandler):
    share_dir = ""

    def log_message(self, format, *args):
        # Clean terminal logging
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path in ['/', '/index.html']:
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode('utf-8'))
            return

        if path == '/api/files':
            files_data = []
            try:
                for entry in sorted(os.scandir(self.share_dir), key=lambda e: e.name.lower()):
                    if entry.is_file() and not entry.name.startswith('.'):
                        stat = entry.stat()
                        files_data.append({
                            'name': entry.name,
                            'size': stat.st_size,
                            'size_formatted': format_size(stat.st_size),
                            'mtime': stat.st_mtime,
                        })
            except Exception as e:
                print(f"Error reading directory: {e}")

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(files_data).encode('utf-8'))
            return

        if path.startswith('/download/'):
            filename = urllib.parse.unquote(path[len('/download/'):])
            safe_name = os.path.basename(filename)
            file_path = os.path.join(self.share_dir, safe_name)

            if os.path.isfile(file_path):
                file_size = os.path.getsize(file_path)
                self.send_response(200)
                self.send_header('Content-Type', 'application/octet-stream')
                self.send_header(
                    'Content-Disposition',
                    f'attachment; filename="{safe_name}"',
                )
                self.send_header('Content-Length', str(file_size))
                self.end_headers()
                with open(file_path, 'rb') as f:
                    shutil.copyfileobj(f, self.wfile)
                print(f"  \033[32m✔\033[0m Downloaded to phone: {safe_name} ({format_size(file_size)})")
            else:
                self.send_error(404, "File Not Found")
            return

        self.send_error(404, "Not Found")

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == '/api/upload':
            query = urllib.parse.parse_qs(parsed.query)
            raw_filename = query.get('filename', ['upload.bin'])[0]
            safe_filename = make_safe_filename(self.share_dir, raw_filename)
            dest_path = os.path.join(self.share_dir, safe_filename)

            try:
                content_length = int(self.headers.get('Content-Length', 0))
            except ValueError:
                content_length = 0

            remaining = content_length
            chunk_size = 1024 * 1024  # 1MB buffer

            with open(dest_path, 'wb') as f:
                while remaining > 0:
                    read_len = min(remaining, chunk_size)
                    chunk = self.rfile.read(read_len)
                    if not chunk:
                        break
                    f.write(chunk)
                    remaining -= len(chunk)

            size_str = format_size(content_length)
            print(f"  \033[32m✔\033[0m Uploaded from phone: \033[1m{safe_filename}\033[0m ({size_str})")
            notify_desktop(safe_filename, size_str)

            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({'status': 'ok', 'filename': safe_filename, 'size': content_length}).encode('utf-8'))
            return

        self.send_error(404, "Not Found")


class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True


def main():
    parser = argparse.ArgumentParser(description="Phone Web Share Server")
    parser.add_argument('--dir', default=os.path.expanduser('~/Downloads/Phone_Transfer'), help="Directory to share and save files")
    parser.add_argument('--port', type=int, default=8080, help="Port to listen on")
    args = parser.parse_args()

    share_dir = os.path.abspath(os.path.expanduser(args.dir))
    os.makedirs(share_dir, exist_ok=True)
    FastTransferHandler.share_dir = share_dir

    local_ip = get_local_ip()
    port = args.port

    server = None
    for p in range(port, port + 20):
        try:
            server = ThreadedTCPServer(('0.0.0.0', p), FastTransferHandler)
            port = p
            break
        except OSError:
            continue

    if not server:
        print(f"\033[31mError:\033[0m Could not bind to port {args.port} or subsequent ports.")
        sys.exit(1)

    url = f"http://{local_ip}:{port}"

    print("\n\033[1m\033[36m╭──────────────────────────────────────────────────────────╮\033[0m")
    print(f"\033[1m\033[36m│\033[0m  \033[1m📱 Instant Phone Web Share\033[0m                              \033[1m\033[36m│\033[0m")
    print(f"\033[1m\033[36m│\033[0m  Shared Folder: \033[33m{share_dir[:40]:<40}\033[0m \033[1m\033[36m│\033[0m")
    print(f"\033[1m\033[36m│\033[0m  URL:           \033[1m\033[32m{url:<40}\033[0m \033[1m\033[36m│\033[0m")
    print("\033[1m\033[36m╰──────────────────────────────────────────────────────────╯\033[0m\n")

    # Generate QR Code if qrencode is available
    if shutil.which('qrencode'):
        print("  \033[1mScan with your phone camera to connect:\033[0m\n")
        try:
            subprocess.run(['qrencode', '-t', 'UTF8', '-m', '2', url], check=False)
        except Exception:
            pass
    else:
        print(f"  Open \033[1m\033[32m{url}\033[0m in your phone's browser.")
        print("  \033[90m(Install 'qrencode' to display a scannable QR code directly here)\033[0m\n")

    print(f"  \033[34mℹ\033[0m Ready! Uploaded files will be saved to: {share_dir}")
    print("  \033[90mPress Ctrl+C to stop the server.\033[0m\n")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  \033[33mStopping server...\033[0m")
        server.shutdown()
        server.server_close()


if __name__ == '__main__':
    main()
