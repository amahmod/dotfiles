#!/usr/bin/env python3
"""
phone-webserver: Lightweight local Wi-Fi file transfer server with QR code.
Allows instant two-way file sharing between PC and any mobile phone via browser.
No mobile app required. Works with Android and iOS alike.
"""

import argparse
import html
import http.server
import json
import os
import shutil
import socket
import socketserver
import subprocess
import sys
import urllib.parse
from pathlib import Path


def get_local_ip():
    """Detect the local Wi-Fi / LAN IP address."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('1.1.1.1', 80))
        return s.getsockname()[0]
    except Exception:
        try:
            return socket.gethostbyname(socket.gethostname())
        except Exception:
            return '127.0.0.1'
    finally:
        s.close()


def format_size(size_bytes):
    """Format bytes to human-readable string."""
    for unit in ['B', 'KB', 'MB', 'GB']:
        if size_bytes < 1024.0:
            return f'{size_bytes:.1f} {unit}'
        size_bytes /= 1024.0
    return f'{size_bytes:.1f} TB'


def notify_desktop(filename, size_str):
    """Send desktop notification when a file upload completes."""
    try:
        subprocess.run(
            [
                'notify-send',
                '-i',
                'phone',
                '-a',
                'Phone Web Share',
                '📱 File Received from Phone',
                f'{filename} ({size_str})',
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def make_safe_filename(target_dir, raw_name):
    """Sanitize and prevent path traversal; generate unique filename if exists."""
    clean = os.path.basename(urllib.parse.unquote(raw_name)).strip()
    if not clean:
        clean = 'uploaded_file'
    base, ext = os.path.splitext(clean)
    candidate = clean
    counter = 1
    while os.path.exists(os.path.join(target_dir, candidate)):
        candidate = f'{base} ({counter}){ext}'
        counter += 1
    return candidate


